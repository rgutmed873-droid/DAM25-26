@startuml
title Sistema de Alquiler de Bicicletas Urbanas

actor Usuario
participant AppBici
participant ServidorCentral
participant GestorUsuarios
participant CandadoElectronico

Usuario -> AppBici: escanearQR()
AppBici -> ServidorCentral: solicitarAlquiler()
ServidorCentral -> ServidorCentral: procesarAlquiler()
ServidorCentral -> GestorUsuarios: comprobarSaldo(idUsuario)
GestorUsuarios --> ServidorCentral: saldoCorrecto

alt Saldo Correcto

ServidorCentral -> CandadoElectronico: desbloquear()
end
@enduml